        gen_bake_apply_ap_row.BeginHorizontal()
        gen_bake_apply_ap_row.Add(self.btn_gen_aperture, xscale=True)
        gen_bake_apply_ap_row.Add(self.btn_bake_aperture, xscale=True)
        gen_bake_apply_ap_row.Add(self.btn_send_to_gh, xscale=True)
