        ap_layout.AddRow(self.num_ratio)
        
        ap_layout.AddSpace()
        ap_layout.AddRow(Forms.Label(Text="Dimensions (W x H):"))
        
        dim_row = Forms.DynamicLayout()
        dim_row.BeginHorizontal()
        dim_row.Add(Forms.Label(Text="W:"))
