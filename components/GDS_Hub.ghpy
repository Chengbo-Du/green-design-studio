        grp_door_preview.Content = door_prev_layout
        
        right_layout.Add(grp_door, xscale=True, yscale=False)
        right_layout.Add(grp_door_preview, xscale=True, yscale=True)
        
        columns.Add(grp_surf, xscale=False, yscale=True)
        columns.Add(middle_layout, xscale=False, yscale=True)
        columns.Add(right_layout, xscale=True, yscale=True)
        columns.EndHorizontal()
        
        layout.Add(columns, xscale=True, yscale=True)
        
        self.tab_envelope.Content = layout
    
    def _create_schedule_module(self):
        layout = Forms.DynamicLayout()
        layout.DefaultSpacing = Drawing.Size(8, 8)
        layout.Padding = Drawing.Padding(10)
        
        columns = Forms.DynamicLayout()
        columns.DefaultSpacing = Drawing.Size(8, 0)
        columns.BeginHorizontal()
        
        # --- LEFT: Room Selection (Scrollable) ---
        grp_rooms = Forms.GroupBox(Text="Room Selection")
        self._sched_col_left = grp_rooms  # Store reference for dynamic sizing
        left_scrollable = Forms.Scrollable()
        left_scrollable.ExpandContentWidth = True
        left_scrollable.ExpandContentHeight = False
        rooms_layout = Forms.DynamicLayout()
        rooms_layout.DefaultSpacing = Drawing.Size(5, 5)
        rooms_layout.Padding = Drawing.Padding(8)
        
        self.lbl_rooms_status = Forms.Label(Text="Use Upstream Rooms")
        rooms_layout.AddRow(self.lbl_rooms_status)
        
        self.btn_load_rooms = Forms.Button(Text="Use Upstream Rooms")
        rooms_layout.AddRow(self.btn_load_rooms)
        
        self.btn_reload_gds = Forms.Button(Text="Reload GDS Database")
        rooms_layout.AddRow(self.btn_reload_gds)
        
        self.lbl_gds_status = Forms.Label(Text="GDS: Not loaded")
        rooms_layout.AddRow(self.lbl_gds_status)
        
        rooms_layout.AddRow(Forms.Label(Text="Rooms (Ctrl+Click for multiple):"))
        self.grid_rooms = Forms.GridView()
        self.grid_rooms.Height = 250
        self.grid_rooms.AllowMultipleSelection = True
        
        col_name = Forms.GridColumn()
        col_name.HeaderText = "Room"
        col_name.DataCell = Forms.TextBoxCell(0)
        col_name.Width = 120
        self.grid_rooms.Columns.Add(col_name)
        
        col_area = Forms.GridColumn()
        col_area.HeaderText = "Area"
        col_area.DataCell = Forms.TextBoxCell(1)
        col_area.Width = 60
        self.grid_rooms.Columns.Add(col_area)
        
        col_prog = Forms.GridColumn()
        col_prog.HeaderText = "Preset Program"
        col_prog.DataCell = Forms.TextBoxCell(2)
        col_prog.Width = 120
        self.grid_rooms.Columns.Add(col_prog)
        
        rooms_layout.Add(self.grid_rooms, yscale=True)
        
        self.btn_preview_rooms = Forms.Button(Text="Preview Selection")
        rooms_layout.AddRow(self.btn_preview_rooms)
        
        self.lbl_room_selection = Forms.Label(Text="")
        rooms_layout.AddRow(self.lbl_room_selection)
        
        # Room examination panel
        rooms_layout.AddRow(Forms.Label(Text="Selected Room Info:"))
        self.txt_room_exam = Forms.TextArea()
        self.txt_room_exam.ReadOnly = True
        self.txt_room_exam.Height = 80
        try:
            self.txt_room_exam.Font = Drawing.Font("Consolas", 8)
        except:
            pass
        rooms_layout.Add(self.txt_room_exam, xscale=True)
        
        # ─── Thermal Comfort Simulation ───
        grp_comfort = Forms.GroupBox(Text="Thermal Comfort Simulation")
        comfort_layout = Forms.DynamicLayout()
        comfort_layout.DefaultSpacing = Drawing.Size(3, 3)
        comfort_layout.Padding = Drawing.Padding(6)
        
        self.chk_comfort_enable = Forms.CheckBox(Text="Enable Fanger Comfort Model")
        self.chk_comfort_enable.Checked = False
        comfort_layout.AddRow(self.chk_comfort_enable)
        
        self.pnl_comfort_params = Forms.Panel()
        comfort_params_layout = Forms.DynamicLayout()
        comfort_params_layout.DefaultSpacing = Drawing.Size(3, 3)
        
        model_row = Forms.DynamicLayout()
        model_row.BeginHorizontal()
        lbl_model = Forms.Label(Text="Model:")
        lbl_model.Width = 75
        model_row.Add(lbl_model)
        self.dd_comfort_model = Forms.DropDown()
        for m in ["Fanger", "Pierce", "KSU", "AdaptiveASH55", "AdaptiveCEN15251"]:
            self.dd_comfort_model.Items.Add(m)
        self.dd_comfort_model.SelectedIndex = 0
        self.dd_comfort_model.Width = 110
        self.dd_comfort_model.Height = 21
        model_row.Add(self.dd_comfort_model)
        model_row.EndHorizontal()
        comfort_params_layout.Add(model_row)
        
        def add_comfort_row(label, attr, unit, decimals, default, min_val=0, max_val=10):
            row = Forms.DynamicLayout()
            row.BeginHorizontal()
            lbl = Forms.Label(Text=label)
            lbl.Width = 75
            row.Add(lbl)
            num = Forms.NumericUpDown()
            num.MinValue = min_val
            num.MaxValue = max_val
            num.DecimalPlaces = decimals
            num.Value = default
            num.Width = 65
            setattr(self, "num_comfort_" + attr, num)
            row.Add(num)
            row.Add(Forms.Label(Text=unit))
            row.EndHorizontal()
            comfort_params_layout.Add(row)
        
        add_comfort_row("Clothing:", "clothing", "clo", 2, 0.7, 0, 2)
        add_comfort_row("Air Velocity:", "air_vel", "m/s", 2, 0.1, 0, 2)
        add_comfort_row("Work Eff:", "work_eff", "", 2, 0.0, 0, 1)
        add_comfort_row("Ankle Vel:", "ankle_vel", "m/s", 2, 0.0, 0, 2)
        
        self.chk_ashrae_warnings = Forms.CheckBox(Text="ASHRAE 55 Warnings")
        self.chk_ashrae_warnings.Checked = False
        comfort_params_layout.AddRow(self.chk_ashrae_warnings)
        
        preset_comfort_row = Forms.DynamicLayout()
        preset_comfort_row.BeginHorizontal()
        self.btn_comfort_office = Forms.Button(Text="Office")
        self.btn_comfort_office.Width = 50
        preset_comfort_row.Add(self.btn_comfort_office)
        self.btn_comfort_residential = Forms.Button(Text="Resid")
        self.btn_comfort_residential.Width = 50
        preset_comfort_row.Add(self.btn_comfort_residential)
        self.btn_comfort_summer = Forms.Button(Text="Summer")
        self.btn_comfort_summer.Width = 50
        preset_comfort_row.Add(self.btn_comfort_summer)
        preset_comfort_row.Add(None)
        preset_comfort_row.EndHorizontal()
        comfort_params_layout.Add(preset_comfort_row)
        
        self.pnl_comfort_params.Content = comfort_params_layout
        self.pnl_comfort_params.Visible = False
        comfort_layout.Add(self.pnl_comfort_params)
        
        send_comfort_row = Forms.DynamicLayout()
        send_comfort_row.BeginHorizontal()
        self.btn_send_comfort = Forms.Button(Text="Send to GH")
        self.btn_send_comfort.Enabled = False
        send_comfort_row.Add(self.btn_send_comfort)
        send_comfort_row.Add(None)
        send_comfort_row.EndHorizontal()
        comfort_layout.Add(send_comfort_row)
        
        self.lbl_comfort_status = Forms.Label(Text="")
        comfort_layout.AddRow(self.lbl_comfort_status)
        
        grp_comfort.Content = comfort_layout
        rooms_layout.Add(grp_comfort, xscale=True)
        
        left_scrollable.Content = rooms_layout
        grp_rooms.Content = left_scrollable
        
        # --- MIDDLE: Program Definition (Scrollable) ---
        middle_scrollable = Forms.Scrollable()
        middle_scrollable.ExpandContentWidth = True
        middle_scrollable.ExpandContentHeight = False
        self._sched_col_mid = middle_scrollable  # Store reference for dynamic sizing
        
        middle_layout = Forms.DynamicLayout()
        middle_layout.DefaultSpacing = Drawing.Size(5, 4)
        
        # Load Intensities
        grp_loads = Forms.GroupBox(Text="Load Intensities")
        loads_layout = Forms.DynamicLayout()
        loads_layout.DefaultSpacing = Drawing.Size(5, 3)
        loads_layout.Padding = Drawing.Padding(6)
        
        loads_layout.AddRow(Forms.Label(Text="Program Name:"))
        self.txt_program_id = Forms.TextBox()
        self.txt_program_id.Text = "GDS_Custom_Program"
        loads_layout.AddRow(self.txt_program_id)
        
        preset_row = Forms.DynamicLayout()
        preset_row.BeginHorizontal()
        preset_row.Add(Forms.Label(Text="Preset:"))
        self.dropdown_space_type = Forms.DropDown()
        preset_row.Add(self.dropdown_space_type)
        self.btn_apply_preset = Forms.Button(Text="Apply")
        self.btn_apply_preset.Width = 45
        preset_row.Add(self.btn_apply_preset)
        preset_row.EndHorizontal()
        loads_layout.Add(preset_row)
        
        def add_intensity_row(label, attr, unit, decimals=4, default=0.0):
            row = Forms.DynamicLayout()
            row.BeginHorizontal()
            lbl = Forms.Label(Text=label)
            lbl.Width = 75
            row.Add(lbl)
            num = Forms.NumericUpDown()
            num.MinValue = 0
            num.MaxValue = 1000
            num.DecimalPlaces = decimals
            num.Value = default
            num.Width = 65
            setattr(self, "num_" + attr, num)
            row.Add(num)
            row.Add(Forms.Label(Text=unit))
            row.EndHorizontal()
            loads_layout.Add(row)
        
        add_intensity_row("People:", "people_density", "p/m²", 4, 0.0565)
        add_intensity_row("Lighting:", "lighting_power", "W/m²", 2, 10.76)
        add_intensity_row("Elec Equip:", "equipment_power", "W/m²", 2, 10.76)
        add_intensity_row("Gas Equip:", "gas_power", "W/m²", 2, 0.0)
        add_intensity_row("Infiltration:", "infiltration", "m³/s/m²", 5, 0.0003)
        add_intensity_row("Vent/Person:", "vent_person", "m³/s/p", 4, 0.006)
        add_intensity_row("Vent/Area:", "vent_area", "m³/s/m²", 5, 0.0003)
        
        # ─── Service Hot Water separator ───
        shw_sep = Forms.Label(Text="─── Service Hot Water ───")
        shw_sep.TextAlignment = Forms.TextAlignment.Center
        loads_layout.AddRow(shw_sep)
        
        # SHW Preset row
        shw_preset_row = Forms.DynamicLayout()
        shw_preset_row.BeginHorizontal()
        shw_preset_row.Add(Forms.Label(Text="SHW Preset:"))
        self.dd_shw_load_preset = Forms.DropDown()
        for p in ["None", "Residential", "Residential - ABC Baseline", "Office", "Hotel"]:
            self.dd_shw_load_preset.Items.Add(p)
        self.dd_shw_load_preset.SelectedIndex = 0
        self.dd_shw_load_preset.Width = 95
        self.dd_shw_load_preset.Height = 21
        shw_preset_row.Add(self.dd_shw_load_preset)
        self.btn_apply_shw_preset = Forms.Button(Text="Apply")
        self.btn_apply_shw_preset.Width = 45
        shw_preset_row.Add(self.btn_apply_shw_preset)
        shw_preset_row.EndHorizontal()
        loads_layout.Add(shw_preset_row)
        
        # SHW intensity rows (reuse same pattern)
        def add_shw_row(label, attr, unit, decimals=2, default=0.0, max_val=100):
            row = Forms.DynamicLayout()
            row.BeginHorizontal()
            lbl = Forms.Label(Text=label)
            lbl.Width = 75
            row.Add(lbl)
            num = Forms.NumericUpDown()
            num.MinValue = 0
            num.MaxValue = max_val
            num.DecimalPlaces = decimals
            num.Value = default
            num.Width = 65
            setattr(self, "num_shw_" + attr, num)
            row.Add(num)
            row.Add(Forms.Label(Text=unit))
            row.EndHorizontal()
            loads_layout.Add(row)
        
        add_shw_row("Flow/Area:", "flow", "L/h/m²", 3, 0.0, 50.0)
        add_shw_row("Target Temp:", "temp", "°C", 1, 49.0, 100.0)
        add_shw_row("Sensible:", "sensible", "", 2, 0.2, 1.0)
        add_shw_row("Latent:", "latent", "", 2, 0.05, 1.0)
        
        # SHW Schedule dropdown
        shw_sched_row = Forms.DynamicLayout()
        shw_sched_row.BeginHorizontal()
        lbl = Forms.Label(Text="SHW Sched:")
        lbl.Width = 75
        shw_sched_row.Add(lbl)
        self.dd_shw_schedule = Forms.DropDown()
        self.dd_shw_schedule.Width = 115
        self.dd_shw_schedule.Height = 21
        shw_sched_row.Add(self.dd_shw_schedule)
        shw_sched_row.EndHorizontal()
        loads_layout.Add(shw_sched_row)
        
        # SHW Equipment Type dropdown (determines fuel source)
        shw_equip_row = Forms.DynamicLayout()
        shw_equip_row.BeginHorizontal()
        lbl_equip = Forms.Label(Text="SHW Equip:")
        lbl_equip.Width = 75
        shw_equip_row.Add(lbl_equip)
        self.dd_shw_equipment = Forms.DropDown()
        for et in SHW_EQUIPMENT_TYPES:
            self.dd_shw_equipment.Items.Add(et)
        self.dd_shw_equipment.SelectedIndex = 0
        self.dd_shw_equipment.Width = 115
        self.dd_shw_equipment.Height = 21
        shw_equip_row.Add(self.dd_shw_equipment)
        shw_equip_row.EndHorizontal()
        loads_layout.Add(shw_equip_row)
        
        # ── SHW Tank Parameters (shown only for tank-type heaters) ──
        self.shw_tank_panel = Forms.DynamicLayout()
        self.shw_tank_panel.DefaultSpacing = Drawing.Size(5, 2)
        
        # Tank UA row
        ua_row = Forms.DynamicLayout()
        ua_row.BeginHorizontal()
        lbl_ua = Forms.Label(Text="Tank UA:")
        lbl_ua.Width = 75
        ua_row.Add(lbl_ua)
        self.num_shw_tank_ua = Forms.NumericStepper()
        self.num_shw_tank_ua.DecimalPlaces = 1
        self.num_shw_tank_ua.MinValue = 0.0
        self.num_shw_tank_ua.MaxValue = 100.0
        self.num_shw_tank_ua.Value = 6.0
        self.num_shw_tank_ua.Width = 70
        self.num_shw_tank_ua.Height = 21
        self.num_shw_tank_ua.Increment = 0.5
        ua_row.Add(self.num_shw_tank_ua)
        ua_row.Add(Forms.Label(Text="W/K"))
        ua_row.EndHorizontal()
        self.shw_tank_panel.Add(ua_row)
        
        # Ambient temperature row
        amb_row = Forms.DynamicLayout()
        amb_row.BeginHorizontal()
        lbl_amb = Forms.Label(Text="Ambient:")
        lbl_amb.Width = 75
        amb_row.Add(lbl_amb)
        self.num_shw_ambient = Forms.NumericStepper()
        self.num_shw_ambient.DecimalPlaces = 1
        self.num_shw_ambient.MinValue = 0.0
        self.num_shw_ambient.MaxValue = 50.0
        self.num_shw_ambient.Value = 22.0
        self.num_shw_ambient.Width = 70
        self.num_shw_ambient.Height = 21
        self.num_shw_ambient.Increment = 0.5
        amb_row.Add(self.num_shw_ambient)
        amb_row.Add(Forms.Label(Text="°C"))
        amb_row.EndHorizontal()
        self.shw_tank_panel.Add(amb_row)
        
        # Efficiency row
        eff_row = Forms.DynamicLayout()
        eff_row.BeginHorizontal()
        lbl_eff = Forms.Label(Text="Efficiency:")
        lbl_eff.Width = 75
        eff_row.Add(lbl_eff)
        self.num_shw_efficiency = Forms.NumericStepper()
        self.num_shw_efficiency.DecimalPlaces = 2
        self.num_shw_efficiency.MinValue = 0.1
        self.num_shw_efficiency.MaxValue = 5.0
        self.num_shw_efficiency.Value = 1.0
        self.num_shw_efficiency.Width = 70
        self.num_shw_efficiency.Height = 21
        self.num_shw_efficiency.Increment = 0.05
        eff_row.Add(self.num_shw_efficiency)
        eff_row.EndHorizontal()
        self.shw_tank_panel.Add(eff_row)
        
        loads_layout.Add(self.shw_tank_panel)
        self._update_shw_tank_visibility()
        
        grp_loads.Content = loads_layout
        middle_layout.Add(grp_loads, xscale=True)
        
        # Schedule Assignments
        grp_sched = Forms.GroupBox(Text="Schedule Assignments")
        sched_layout = Forms.DynamicLayout()
        sched_layout.DefaultSpacing = Drawing.Size(5, 3)
        sched_layout.Padding = Drawing.Padding(6)
        
        def add_schedule_row(label, attr):
            row = Forms.DynamicLayout()
            row.BeginHorizontal()
            lbl = Forms.Label(Text=label)
            lbl.Width = 70
            row.Add(lbl)
            dd = Forms.DropDown()
            dd.Width = 115
            dd.Height = 21
            setattr(self, "dd_" + attr, dd)
            row.Add(dd)
